  Def.Quad{
    Name= "actor_AC",
    InitCommand= function(self)
		
			mawaru_breath_obj = {}
			mawaru_breath_bptr = 1;
		
			function mawaru_breath_place(pn,x,y)
			
				local b = mawaru_breath_obj[mawaru_breath_bptr];
				
				if not b then return end
				
				a = b.actor;
				
				a:visible(true);
				a:sleep(0);
				a:diffusealpha(0);
				a:rotationz(math.random(0,360));
				a:zoom(1.2);
				a:x(x+(SCREEN_CENTER_X*pn));
				a:y(y);
				a:linear(0.3);
				a:diffusealpha(1);
				a:zoom(1.8);
				a:linear(1.5);
				a:diffusealpha(0);
				a:zoom(0.9);
				
				a:queuecommand('Hide');
			
				mawaru_breath_bptr = mawaru_breath_bptr+1;
				if mawaru_breath_bptr > table.getn(mawaru_breath_obj) then
					mawaru_breath_bptr = 1
				end
			end
			
		end,
    KillCommand= function(self)
			--any cleanup, if necessary
		end,
    StartCommand= function(self)
			
			mawaru_breathed = 220-.1;
			
			self:sleep(0.02);
			self:queuecommand('Update');

		end,
    UpdateCommand= function(self)
			
			if GAMESTATE:GetSongBeat() > mawaru_breathed and GAMESTATE:GetSongBeat() < 235 then
				mawaru_breath_pos1 = {x=math.random(0,SCREEN_CENTER_X*0.8)+(SCREEN_CENTER_X*0.1),y=math.random(0,SCREEN_HEIGHT*0.8)+SCREEN_HEIGHT*0.1}
				mawaru_breath_pos2 = {x=math.random(0,SCREEN_CENTER_X*0.8)+(SCREEN_CENTER_X*0.1),y=math.random(0,SCREEN_HEIGHT*0.8)+SCREEN_HEIGHT*0.1}
				
				for pn=0,1 do
					mawaru_breath_place(pn,mawaru_breath_pos1.x,mawaru_breath_pos1.y)
					mawaru_breath_place(pn,mawaru_breath_pos2.x,mawaru_breath_pos2.y)
				end
				
				mawaru_breathed = mawaru_breathed+2;
				
			end
			
			self:sleep(0.02);
			if mawaru_curgame == 4 then
				self:queuecommand('Update');
			end
			
		end,
