local function diff_to_number(difficult)--Low-grade code for compatibility reasons. -Kid
    if not difficult then return
    elseif difficult == 'Difficulty_Beginner' then return 0
    elseif difficult == 'Difficulty_Easy' then return 1
    elseif difficult == 'Difficulty_Medium' then return 2
    elseif difficult == 'Difficulty_Hard' then return 3
    elseif difficult == 'Difficulty_Challenge' then return 4
    elseif difficult == 'Difficulty_Edit' then return 5
    end
end
P1Steps = diff_to_number(GAMESTATE:GetCurrentSteps(PLAYER_1):GetDifficulty())--This makes things simpler. -Kid
P2Steps = diff_to_number(GAMESTATE:GetCurrentSteps(PLAYER_2):GetDifficulty())

local cond_Fg_result= P1Steps<2 and P2Steps>=2

local cond_Eg_result= P1Steps>=2 and P2Steps<2

local cond_Dg_result= P1Steps>=2 and not GAMESTATE:IsHumanPlayer(1) or P2Steps>=2 and not GAMESTATE:IsHumanPlayer(0) or P1Steps>=2 and P2Steps>=2 or P1Steps<2 and not GAMESTATE:IsHumanPlayer(1) or P2Steps<2 and not GAMESTATE:IsHumanPlayer(0) or P1Steps<2 and P2Steps<2

--Due to GetDifficulty returning an enum and not a number:
--GetDifficulty()<2 becomes GetDifficulty()== ('Difficulty_Beginner' or 'Difficulty_Easy'). -Kid
--GetDifficulty()>=2 becomes GetDifficulty()== ('Difficulty_Medium' or 'Difficulty_Hard' or 'Difficulty_Challenge' or 'Difficulty_Edit'). -Kid
