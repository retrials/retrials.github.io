			local text = 'Player 1:\n'
			
			text = text..'Steps score: '..mawaru_p1sscore..'%\n'
			
			mawaru_gamesP1_mb = 0;
			for i=1, 5 do
				if mawaru_gamesP1[i] == 1 then mawaru_gamesP1_mb = mawaru_gamesP1_mb+1 end
			end
			
			text = text..'Minigames: '..mawaru_gamesP1_mb..'/5 = +'..(mawaru_gamesP1_mb*5)..'%\n'
