	mawaru_gamemenu_allowaccess = false
	
	----------------------------------------------------------------
	-- GOD INPUT ---------------------------------------------------
	----------------------------------------------------------------
	god_Directions = {'Left', 'Down', 'Up', 'Right'}
	function god_CheckForChange(player, arrow)
		local letter = string.sub(arrow,1,1)
		local VarName = letter..'pressP'..player
		local LastSeenVarName = 'LastSeen'..VarName
	
		if _G[LastSeenVarName] ~= _G[VarName] then
			_G[LastSeenVarName] = _G[VarName]
			if _G[VarName] == 1 then
				MESSAGEMAN:Broadcast('Step'..arrow..'P'..player)
			else
				MESSAGEMAN:Broadcast('Lift'..arrow..'P'..player)
			end
		end			
		if _G[VarName] == 1 then
			MESSAGEMAN:Broadcast('Hold'..arrow..'P'..player)
		end
	end
	----------------------------------------------------------------
	-- END GOD INPUT -----------------------------------------------
	----------------------------------------------------------------

	songName = GAMESTATE:GetCurrentSong():GetSongDir();
	ispressed = 0; 	-- variable to check if green button is pressed
	mawaru_keys = {0,0,0,0,0,0,0,0};
	mawaru_held = {0,0,0,0,0,0,0,0};
	
	mawaru_start_delay = 0;
	
	mawaru_editor = false;
	mawaru_divine = false;
	mawaru_god = false;
	for pn=1,2 do
		if GAMESTATE:PlayerIsUsingModifier(pn-1,'DivinEntity') then
			mawaru_divine = true;
		end
		if GAMESTATE:PlayerIsUsingModifier(pn-1,'cel-cmd') or GAMESTATE:PlayerIsUsingModifier(pn-1,',metal-cmd')
		or GAMESTATE:PlayerIsUsingModifier(pn-1,'cel-cmd-notweens') or GAMESTATE:PlayerIsUsingModifier(pn-1,',metal-cmd-notweens') then
			mawaru_god = true;
		end
	end
	
	if GAMESTATE:GetEnv('missionmode') and GAMESTATE:GetEnv('missionmode') == 1 then
		PREFSMAN:SetPreference('OnlyDedicatedMenuButtons',true);
	end
	
	mawaru_firstSeenBeat = GAMESTATE:GetSongBeat(); --editor
	
	--handle start button
	function mawaru_hitStart()
		
	end
	
	function mawaru_win(pn)
		
	end
	
	function mawaru_opposite(pn)
		if pn == 1 then return 2 else return 1 end
	end
	
	mawaru_text_dirs = {'&LEFT;','&DOWN;','&UP;','&RIGHT;'}
	
	function mawaru_dist(a,b)
		return math.sqrt(math.pow((a:GetX()-b:GetX()),2)+math.pow((a:GetY()-b:GetY()),2));
	end
	
	function mawaru_angle(a,b)
		return math.atan2(b:GetX()-a:GetX(),b:GetY()-a:GetY());
	end
	
	function mawaru_dist2(ax,ay,bx,by)
		return math.sqrt(math.pow((ax-bx),2)+math.pow((ay-by),2));
	end
	
	function mawaru_angle2(ax,ay,bx,by)
		return math.atan2(bx-ax,by-ay);
	end
	
	function mawaru_mag(x,y)
		return math.sqrt(x*x+y*y)
	end
	
	function mawaru_flipAngleDeg(old_angle,axis)
		--[[
		flip_angle(old_angle,axis)
		function: flips an angle over an axisx7
		returns: new angle
		]]
		
		old_angle=math.mod(old_angle,360)
		
		return math.mod(((2*axis)-old_angle)+360,360)
	end
	
	function mawaru_normrad2deg(ang)
		ang = math.deg(ang);
		while ang<0 do
			ang = ang+360;
		end
		while ang>360 do
			ang = ang-360;
		end
		return ang;
	end
	
	function mawaru_sound(soundName)
		SOUND:PlayOnce(songName..'lua/'..soundName);
	end
	
	function ninja_format(num, zeroes)
		local ret = tostring(num)
		while zeroes>0 do
			if num < math.pow(10,zeroes-1) then
				ret = '0'..ret
			end
			zeroes = zeroes-1;
		end
		return ret
	end
	
	function mawaru_4digits(n)
		if n >= 0 and n < 10 then return '000'..n; end
		if n > 9 and n < 100 then return '00'..n; end
		if n > 99 and n < 1000 then return '0'..n; end
		if n > 999 and n < 10000 then return n; end
		return n
	end
	
	self:fov(60);
	
end"
