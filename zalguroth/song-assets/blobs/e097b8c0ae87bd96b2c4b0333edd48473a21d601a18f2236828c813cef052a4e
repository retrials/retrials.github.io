	-- kobe!!
	local RATES = {'1.1','1.2','1.3','1.4','1.5','1.6','1.7','1.8','1.9','2.0'};
	RATEMOD = 1;
	for i = 1, table.getn(RATES) do
		if GAMESTATE:PlayerIsUsingModifier(0,RATES[i]..'xmusic') or GAMESTATE:PlayerIsUsingModifier(1,RATES[i]..'xmusic') then
			RATEMOD = RATES[i];
		end
	end
	
	mawaru_reverse = {0,0}
	
	for pn=0,1 do
		if GAMESTATE:PlayerIsUsingModifier(pn,'reverse') then
			mawaru_reverse[pn+1] = 100;
		end
	end

	mawaru_difficultyP1 = 3;
	mawaru_difficultyP2 = 0;
	
	mawaru_speedmodP1 = 2.5;
	mawaru_speedmodP2 = 2.5;
	
	function mawaru_round(num)
		return math.floor((num * 100) + 0.5) / 100
	end
	function mawaru_round1(num)
		return math.floor((num * 10) + 0.5) / 10
	end
	function mawaru_round0(num)
		return math.floor(num + 0.5)
	end
	
	if GAMESTATE:IsPlayerEnabled(PLAYER_1) then
		mawaru_difficultyP1 = tonumber(GAMESTATE:GetCurrentSteps(PLAYER_1):GetDifficulty());
		for i=0, 10, 0.01 do
			if GAMESTATE:PlayerIsUsingModifier(0,mawaru_round(i)..'x') then mawaru_speedmodP1 = i; break; end
		end
	end
	if GAMESTATE:IsPlayerEnabled(PLAYER_2) then
		mawaru_difficultyP2 = tonumber(GAMESTATE:GetCurrentSteps(PLAYER_2):GetDifficulty());
		for i=0, 10, 0.01 do
			if GAMESTATE:PlayerIsUsingModifier(1,mawaru_round(i)..'x') then mawaru_speedmodP2 = i; break; end
		end
	end
	
	if mawaru_difficultyP1 and not mawaru_difficultyP2 then
		mawaru_maxdifficulty = mawaru_difficultyP1
		mawaru_mindifficulty = mawaru_difficultyP1
	elseif mawaru_difficultyP2 and not mawaru_difficultyP1 then
		mawaru_maxdifficulty = mawaru_difficultyP2
		mawaru_mindifficulty = mawaru_difficultyP2
	elseif mawaru_difficultyP1 and mawaru_difficultyP2 then
		mawaru_maxdifficulty = math.max(mawaru_difficultyP1, mawaru_difficultyP2);
		mawaru_mindifficulty = math.min(mawaru_difficultyP1, mawaru_difficultyP2);
	else
		mawaru_maxdifficulty = 3
		mawaru_mindifficulty = 3
	end
	
	function mawaru_shuffle(t)
		local n = table.getn(t)
	 
		while n >= 2 do
			-- n is now the last pertinent index
			local k = math.random(n) -- 1 <= k <= n
			-- Quick swap
			t[n], t[k] = t[k], t[n]
			n = n - 1
		end
	 
		return t
	end
	
	function mawaru_strip(str)
		local s = str
		local ret = ''
		for i=1,string.len(s) do
			if string.sub(s,i,i) == '\n' then
				ret = ret..'\n'
			else
				ret = ret..' '
			end
		end
		return ret
	end

