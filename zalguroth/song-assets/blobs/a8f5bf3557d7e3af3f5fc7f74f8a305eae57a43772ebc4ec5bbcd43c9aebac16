local function diff_to_num(difficulty)--Yes, it's dumb, but I'm lazy. -Kid
    if difficulty == 'Difficulty_Beginner' then return 0 end
    if difficulty == 'Difficulty_Easy' then return 1 end
    if difficulty == 'Difficulty_Medium' then return 2 end
    if difficulty == 'Difficulty_Hard' then return 3 end
    if difficulty == 'Difficulty_Challenge' then return 4 end
    if difficulty == 'Difficulty_Edit' then return 5 end
end
