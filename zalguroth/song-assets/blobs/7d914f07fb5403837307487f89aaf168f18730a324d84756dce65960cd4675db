	<LAER Type="Quad"
		InitCommand="%function (self)
			mawaru_rave_note = {}
			mawaru_rave_nptr = 1;
			mawaru_rave_dirs = {90,0,180,-90}
			
			mawaru_rave_ret = '';
			
			main_dicks_test = 1;
			
			function mawaru_rave_nextn()
				mawaru_rave_nptr = mawaru_rave_nptr+1;
				if mawaru_rave_nptr > table.getn(mawaru_rave_note) then
					mawaru_rave_nptr = 1
				end
			end
			
			mawaru_rave_scale = 0.8;
			mawaru_rave_speedmod = {1,1,1,1.33,1.66,2};
			
			mawaru_rave_axs = {-96,0,0,96};
			mawaru_rave_ays = {0,96,-96,0};
			
			function mawaru_rave_quantize(obj, b)
				b = b/2;
				local r = b-math.floor(b)
				if r == 0 then mawaru_rave_color(obj,4)
				elseif r == 0.5 then mawaru_rave_color(obj,8)
				elseif (r > 0.33 and r < 0.34) or (r > 0.66 and r < 0.67) then mawaru_rave_color(obj,12)
				elseif r == 0.25 or r == 0.75 then mawaru_rave_color(obj,16)
				elseif (r > 0.166 and r < 0.167) or (r > 0.83 and r < 0.84) then mawaru_rave_color(obj,12)
				elseif r == 0.125 or r == 0.375 or r == 0.625 or r == 0.875 then mawaru_rave_color(obj,32)
				else mawaru_rave_color(obj,64) end
			end
			
			function mawaru_rave_color(obj, n)
				if n == 4 then obj:diffuse(1,0.4,0.3,1); end
				if n == 8 then obj:diffuse(0.3,0.7,1,1); end
				if n == 12 then obj:diffuse(1,0.4,1,1); end
				if n == 16 then obj:diffuse(0.3,1,0.4,1); end
				if n == 32 then obj:diffuse(1,0.8,0.3,1); end
				if n == 64 then obj:diffuse(0.3,1,0.7,1); end
			end
			
			function mawaru_rave_placenote(pn,time,dir)
				
				local speed = RATEMOD*mawaru_rave_speedmod[_G['mawaru_difficultyP'..pn]+1];
			
				local beat = GAMESTATE:GetSongBeat();
				
				--Trace('aptr: '..mawaru_rave_nptr)
				
				local a = mawaru_rave_note[mawaru_rave_nptr];
				if not a then return end
				
				local b = a.actor;
				
				b:hidden(0);
				b:setstate(0);
				
				b:diffusealpha(0);
				
				mawaru_rave_quantize(b, time);
				
				b:glow(1,1,1,0);
				b:zoom(0.5)
				
				b:x((SCREEN_WIDTH*-0.25)+(pn*SCREEN_CENTER_X)+(mawaru_rave_axs[dir]*mawaru_rave_scale));
				b:y((SCREEN_CENTER_Y)+(mawaru_rave_ays[dir]*mawaru_rave_scale));
				b:rotationz(-180);
				
				b:linear(0.5*(60/145)/speed);
				b:diffusealpha(1);
				b:rotationz(-135);
				
				b:linear(1.5*(60/145)/speed);
				b:rotationz(0);
				
				b:sleep(0);
				b:glow(1,1,1,1);
				b:decelerate(.2*(60/145)/speed);
				b:zoom(0.6);
				b:diffusealpha(0);
				
				b:queuecommand('Hide');
				
				mawaru_rave_nextn();
			end
			
