		StartCommand="%function(self)
		
			mawaru_rave_chartp1 = mawaru_rave_charts[mawaru_difficultyP1+1]
			mawaru_rave_chartp2 = mawaru_rave_charts[mawaru_difficultyP2+1]
			
			--variables set up when a game is started
			--wait 2 seconds (for the curtain or whatever) before accepting any inputs
			mawaru_rave_lockinput = {2,2};
			
			self:sleep(0.02);
			if mawaru_curgame == 2 then
				self:queuecommand('Update');
			end

		end"
		UpdateCommand="%function(self)
			
			--game logic
			
			local beat = GAMESTATE:GetSongBeat();
			
			for pn=1,2 do
				
				if GAMESTATE:IsHumanPlayer(pn-1) then
					if _G['mawaru_rave_curnotep'..pn]<=table.getn(_G['mawaru_rave_chartp'..pn]) then
						local c = _G['mawaru_rave_chartp'..pn][_G['mawaru_rave_curnotep'..pn]]
						if beat>c[1]-(2/mawaru_rave_speedmod[_G['mawaru_difficultyP'..pn]+1]) then
							if beat<c[1] then
								--mawaru_rave_placenote(pn,time,dir)
								mawaru_rave_placenote(pn,c[1],c[2])
							end
							_G['mawaru_rave_curnotep'..pn] = _G['mawaru_rave_curnotep'..pn]+1;
							--Trace('PlaceArrow');
						end
					end
				end
				
			end
			
			self:sleep(0.02);
			if mawaru_curgame == 2 then
				self:queuecommand('Update');
			end
			
		end"
