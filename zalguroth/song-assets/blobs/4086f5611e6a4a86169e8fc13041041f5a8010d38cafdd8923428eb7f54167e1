<GAME Type="ActorFrame"><children>

	<LAER Type="Quad"
		InitCommand="%function(self)
		
			mawaru_sparkle_obj = {}
			mawaru_sparkle_bptr = 1;
		
			function mawaru_sparkle_place(x,y)
			
				local b = mawaru_sparkle_obj[mawaru_sparkle_bptr];
				
				if not b then return end
				
				a = b.actor;
				
				local asd = math.random(0,360)
				local asd2 = math.random(0,200) - 100
				
				a:hidden(0);
				a:rainbow();
				a:blend('add');
				a:effectperiod(math.random(30,60)/10)
				a:effectoffset(math.random(15,30)/10);
				a:sleep(0);
				a:diffusealpha(0);
				a:rotationz(asd);
				a:zoom(1);
				a:x(x);
				a:y(y);
				a:linear(0.2);
				a:rotationz(asd+(asd2*0.25));
				a:diffusealpha(1);
				a:zoom(1.2);
				a:linear(0.6);
				a:diffusealpha(0);
				a:rotationz(asd+asd2);
				a:zoom(0.6);
				
				a:queuecommand('Hide');
			
				mawaru_sparkle_bptr = mawaru_sparkle_bptr+1;
				if mawaru_sparkle_bptr > table.getn(mawaru_sparkle_obj) then
					mawaru_sparkle_bptr = 1
				end
				
			end
			
		end"
		StartCommand="%function(self)
			
			mawaru_sparkled = 4-.1;
			
			self:sleep(0.02);
			self:queuecommand('Update');

		end"
		Start2Command="%function(self)
			
			mawaru_sparkled = 688-.1;
			
			self:sleep(0.02);
			self:queuecommand('Update2');

		end"
		UpdateCommand="%function(self)
			
			if GAMESTATE:GetSongBeat() > mawaru_sparkled and GAMESTATE:GetSongBeat() < 19.5 then
				
				for i=0,1 do
					local rx = math.random(0,SCREEN_CENTER_X*1.6)+(SCREEN_CENTER_X*0.2);
					local ry = math.random(0,SCREEN_HEIGHT*0.8)+(SCREEN_HEIGHT*0.1);
					mawaru_sparkle_place(rx,ry)
				end
				
				mawaru_sparkled = mawaru_sparkled+2;
				
			end
			
			self:sleep(0.02);
			if mawaru_curgame == -1 then
				self:queuecommand('Update');
			end
			
		end"
		Update2Command="%function(self)
			
			if GAMESTATE:GetSongBeat() > mawaru_sparkled and GAMESTATE:GetSongBeat() < 695.5 then
				
				for i=0,1 do
					local rx = math.random(0,SCREEN_CENTER_X*1.6)+(SCREEN_CENTER_X*0.2);
					local ry = math.random(0,SCREEN_HEIGHT*0.8)+(SCREEN_HEIGHT*0.1);
					mawaru_sparkle_place(rx,ry)
				end
				
				mawaru_sparkled = mawaru_sparkled+2;
				
			end
			
			self:sleep(0.02);
			if mawaru_curgame == -1 then
				self:queuecommand('Update2');
			end
			
		end"
		KillCommand="%function(self)
			--any cleanup, if necessary
		end"
	/>
	
