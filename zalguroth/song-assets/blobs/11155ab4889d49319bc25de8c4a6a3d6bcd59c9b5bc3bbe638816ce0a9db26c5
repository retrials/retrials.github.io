			--mawaru_ryuko_num_beams = {2,3,4,5,8,11};
			mawaru_ryuko_num_beams = {2,3,4,5,8,2};
			
			mawaru_ryuko_beam_seed = {1,2,3,1,2,3,1,2,3,1,2,3};
			
			function mawaru_ryuko_simulate(pos,t)
				for i=1,table.getn(t) do
					if pos == t[i] then
						pos = pos+1;
					elseif pos == t[i]+1 then
						pos = pos-1;
					end
				end
				return pos;
			end
			
			function mawaru_ryuko_makepath(pos,t,obj,pn)
				obj:linear(1.2/table.getn(t));
				obj:addy(((table.getn(t)-4)*(3*(SCREEN_HEIGHT/480)))+((SCREEN_HEIGHT*0.6)/table.getn(t)));
				for i=1,table.getn(t) do
					if pos == t[i] then
						obj:linear(0.3);
						obj:addx(SCREEN_WIDTH*0.1);
						pos = pos+1;
					elseif pos == t[i]+1 then
						obj:linear(0.3);
						obj:addx(SCREEN_WIDTH*-0.1);
						pos = pos-1;
					end
					obj:linear(1.2/table.getn(t));
					obj:addy(SCREEN_HEIGHT*0.35/table.getn(t));
				end
				obj:linear(0.3)
				obj:addy(SCREEN_HEIGHT*0.1);
				obj:queuemessage('RyukoCheckP'..pn);
			end
			
		end,
