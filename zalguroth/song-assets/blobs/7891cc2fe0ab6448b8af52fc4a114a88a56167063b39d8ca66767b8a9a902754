				table.insert(mawaru_stream_mynotes[pn],b);
				
				b:visible(true);
				
				mawaru_stream_quantize(b, time-1);
				b:zoom(1)
				b:rotationz(mawaru_stream_dirs[dir]);
				b:x((SCREEN_WIDTH*-0.25)+((pn)*SCREEN_CENTER_X)+(mawaru_stream_axs[dir]));
				b:y(mawaru_stream_gety(0)+((time-1)*h));
				
				mawaru_stream_nextn(pn);
			end
			
