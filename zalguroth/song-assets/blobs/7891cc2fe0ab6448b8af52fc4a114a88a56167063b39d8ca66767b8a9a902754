				b = b/4;
				local r = b-math.floor(b)
				if r == 0 then mawaru_stream_color(obj,4)
				elseif r == 0.5 then mawaru_stream_color(obj,8)
				elseif (r > 0.33 and r < 0.34) or (r > 0.66 and r < 0.67) then mawaru_stream_color(obj,12)
				elseif r == 0.25 or r == 0.75 then mawaru_stream_color(obj,16)
				elseif (r > 0.166 and r < 0.167) or (r > 0.83 and r < 0.84) then mawaru_stream_color(obj,12)
				elseif r == 0.125 or r == 0.375 or r == 0.625 or r == 0.875 then mawaru_stream_color(obj,32)
				else mawaru_stream_color(obj,64) end
			end
			
