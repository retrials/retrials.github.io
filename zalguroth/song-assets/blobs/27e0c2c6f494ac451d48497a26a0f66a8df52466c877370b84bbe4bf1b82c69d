				b:rotationz(-180);
				
				b:linear(0.5*(60/145)/speed);
				b:diffusealpha(1);
				b:rotationz(-135);
				
				b:linear(1.5*(60/145)/speed);
				b:rotationz(0);
				
				b:sleep(0);
